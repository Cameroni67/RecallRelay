# RecallRelay public environment variables.
# Copy this file to .env.local and adjust the values.
# All three are NEXT_PUBLIC_* so they are inlined into the browser bundle.

# Data environment label shown by the environment badge: "local" | "hosted"
NEXT_PUBLIC_RECALLRELAY_ENV=local

# Supabase project URL.
# Local stack (custom ports for this project): http://127.0.0.1:54421
# Hosted project: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421

# Supabase publishable (anon) API key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
